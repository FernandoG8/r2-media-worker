{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-media-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  // Preserve TEAM_DOMAIN and POLICY_AUD when they are managed in the dashboard.
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CLIENTS_KV",
      "id": "40efb89ad64745f98767e6b9b0067be6",
      "preview_id": "2e9150a35c1a4fae86d4337ae51c39e2"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://panel-v2.mizcor.dev"
  }
}
